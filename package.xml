<?xml version="1.0"?>
<package format="3">
  <name>seapath</name>
  <version>0.0.0</version>
  <description>A ROS2 driver for the Kongsberg Seapath MRU</description>
  <maintainer email="kkrasnosky@gmail.com">Kristopher Krasnosky</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>io_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
